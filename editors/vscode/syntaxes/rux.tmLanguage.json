{
  "name": "RUX",
  "scopeName": "source.rux",
  "patterns": [
    {
      "name": "comment.line.double-slash.rux",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.rux",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.rux",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.rux",
      "match": "\\b(?:app|fn|let|var|when|else|loop|while|until|in|await|async|return)\\b"
    },
    {
      "name": "constant.language.rux",
      "match": "\\b(?:true|false|null)\\b"
    },
    {
      "name": "constant.numeric.rux",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
    },
    {
      "name": "entity.name.function.rux",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\s*\\()"
    }
  ]
}
